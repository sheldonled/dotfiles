#!/bin/bash

# Install Apple Color Emoji on Linux
# Credits: https://gist.github.com/win0err/9d8c7f0f2eabdfe8a4c9787b02c79ac51

set -e # Exit on error

printf "\n- Installing Apple Color Emoji font\n\n";

# 1. Download font
FONT_DIR="$HOME/.local/share/fonts"
mkdir -p "$FONT_DIR"

echo "Downloading font file..."
wget -q --show-progress https://github.com/samuelngs/apple-emoji-linux/releases/latest/download/AppleColorEmoji.ttf -O "$FONT_DIR/AppleColorEmoji.ttf"

# 2. Modify system-wide font configuration (requires sudo)
# Note: Since modifying /etc/ requires root, we check for sudo privileges
GENERIC_CONF="/etc/fonts/conf.d/60-generic.conf"

if [ -f "$GENERIC_CONF" ]; then
    echo "Updating system font priority in $GENERIC_CONF..."
    # This uses sed to insert the Apple Color Emoji line into the first <prefer> block found
    sudo sed -i '/<prefer>/a \      <family>Apple Color Emoji</family>' "$GENERIC_CONF"
else
    echo "⚠️  Warning: $GENERIC_CONF not found. Skipping system-wide priority step."
fi

# 3. Create local font config
echo "Creating local font configuration..."
mkdir -p "$HOME/.config/fontconfig/"

tee "$HOME/.config/fontconfig/fonts.conf" << FONTS
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
  <alias>
    <family>serif</family>
    <prefer>
      <family>Apple Color Emoji</family>
    </prefer>
  </alias>
  <alias>
    <family>sans-serif</family>
    <prefer>
      <family>Apple Color Emoji</family>
    </prefer>
  </alias>
  <alias>
    <family>monospace</family>
    <prefer>
      <family>Apple Color Emoji</family>
    </prefer>
  </alias>
  <match target="pattern">
    <test qual="any" name="family"><string>Noto Color Emoji</string></test>
    <edit name="family" mode="assign" binding="same"><string>Apple Color Emoji</string></edit>
  </match>
</fontconfig>
FONTS

# 4. Clear font cache
echo "Refreshing font cache..."
fc-cache -f -v

echo "----------------------------------------------------"
echo "✅ Installation complete!"
echo "💡 Note: You may need to restart your computer for changes to take effect."